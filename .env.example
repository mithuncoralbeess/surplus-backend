# Django Settings
SECRET_KEY=django-insecure-change-this-in-production-key-surplus-backend
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=surplus_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=True

# ZeptoMail (Zoho Transactional Email Service) Configuration
EMAIL_SEND_ENABLED=False
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_API_KEY=your_zeptomail_api_key_here
ZEPTOMAIL_FROM_NAME=Surplus Market
ZEPTOMAIL_FROM_EMAIL=noreply@surplusmarket.com

# Standard Django SMTP (Backup)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zeptomail.in
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=your_zeptomail_smtp_password
DEFAULT_FROM_EMAIL=Surplus Market <noreply@surplusmarket.com>
