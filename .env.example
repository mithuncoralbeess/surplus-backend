# Django Settings
SECRET_KEY=django-insecure-change-this-in-production-key-surplus-backend
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_NODE_ID=backend-primary-1

# Database Configuration (PostgreSQL Primary + Read Replicas + Failover Standby)
# Use DATABASE_URL for primary managed cloud DB (Aiven / Neon / Render)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DB_CONN_MAX_AGE=600

# Optional comma-separated Read Replicas for Round-Robin Read Load Balancing:
# DATABASE_REPLICA_URLS=postgres://user:password@replica1:5432/dbname?sslmode=require,postgres://user:password@replica2:5432/dbname?sslmode=require

# Optional Standby / Failover Database when Primary DB is unreachable:
# DATABASE_FALLBACK_URL=postgres://user:password@standby-host:5432/dbname?sslmode=require

DB_ENGINE=django.db.backends.postgresql
DB_NAME=surplus_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSL_REQUIRE=False

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=https://yourdjango.onrender.com,http://localhost:3000

# Cloudflare R2 Media Storage
USE_R2=False
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=app-staging-media
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com


# Email Delivery (Primary: Brevo HTTP API -> Automatic Failover: SMTP Relay)
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_BACKEND = "config.backends.BrevoHTTPEmailBackend"
EMAIL_HOST = "smtp-relay.brevo.com"
EMAIL_PORT = 587
EMAIL_USE_TLS = True
EMAIL_HOST_USER = "your_brevo_smtp_user_here"
EMAIL_HOST_PASSWORD = "your_brevo_smtp_password_here"
DEFAULT_FROM_EMAIL = "Surplus Market <noreply@surplusmarket.com>"
SERVER_EMAIL = "noreply@surplusmarket.com"
ADMIN_NOTIFICATION_EMAIL = "contact@surplusmarket.com"
FRONTEND_URL=https://surplusmarket.com

# Typesense Search Engine Configuration (Automatically fails over to PostgreSQL Full-Text Search)
TYPESENSE_ENABLED=False
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=your_typesense_api_key_here
TYPESENSE_COLLECTION_NAME=surplus_listings
TYPESENSE_TIMEOUT=1.5
